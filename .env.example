# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ppi_bartin"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/ppi_bartin_shadow"

# Better Auth
BETTER_AUTH_URL="https://your-site-url.example"
BETTER_AUTH_SECRET="isi-dengan-secret-random"

# Google OAuth (login)
GOOGLE_CLIENT_ID="client-id-google-oauth"
GOOGLE_CLIENT_SECRET="client-secret-google-oauth"

# UploadThing
UPLOADTHING_TOKEN="uploadthing-token"

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL="https://example.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="supabase-anon-key"

# Financial Dashboard — Phase 1
# Link Google Sheets laporan keuangan (akses: Anyone with the link can view).
# Kosongkan untuk sementara jika link belum diberikan bendahara.
NEXT_PUBLIC_FINANCE_SHEET_URL="https://docs.google.com/spreadsheets/d/1-p7AGA-c-U9WQ2W2ys1wkGD_hgi5j9-afXpAqwa5_uI/edit?usp=sharing"

# Financial Dashboard — Phase 2/3 (Service Account Google Sheets)
# Isi setelah Service Account dibuat. Private key gunakan \n sebagai newline.
GOOGLE_SHEET_ID="SPREADSHEET_ID_dari_url_sheet"
GOOGLE_CLIENT_EMAIL="nama-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Preview UI dengan data contoh (read-only). Jangan aktifkan di produksi.
# Set "true" untuk melihat dashboard sebelum kredensial Google tersedia.
FINANCE_USE_DUMMY_DATA="false"
